<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      M3 引入 Spring Boot 作为父 POM：
      - 统一管理依赖版本（jackson/logback/spring-security-crypto 等都不用再写版本号）；
      - 提供自动配置：数据源(HikariCP)、MyBatis-Plus 都是几行配置的事；
      - M6 的 REST 层本来就要用 Spring MVC，一次到位。
      这也是原版 EasyChatServer 的结构（Spring Boot 应用内嵌 Netty 服务端）。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>easychat-rebuild</artifactId>
    <version>1.0.0</version>
    <name>easychat-rebuild</name>
    <description>协议兼容的 IM 后端复刻项目（M3：MySQL + MyBatis-Plus 真实存储）</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <netty.version>4.1.108.Final</netty.version>
        <!-- MyBatis-Plus 3.5.5+ 才支持 Spring Boot 3（Jakarta EE），版本不能低 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
    </properties>

    <dependencies>
        <!-- Spring Boot 基础（含 spring-jcl） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- M6a：Spring MVC——REST 查询通道（与 Netty TCP 实时通道并存，双通道架构） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- M6a：Redis——在线状态等热数据（Boot 自动配置 Lettuce 客户端） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Netty：NIO 网络框架，长连接服务端核心（Boot 不管 Netty，版本自己定） -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>${netty.version}</version>
        </dependency>
        <!-- Jackson：协议消息体序列化。
             教训：spring-boot-starter-parent 只管版本不管引入——基础 starter 不含
             jackson-databind（JSON 能力在 spring-boot-starter-json 里），
             必须自己声明，只是版本号可以省（Boot 的 dependencyManagement 接管）。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- BCrypt 密码哈希（版本随 Boot 管理） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- MyBatis-Plus（Boot 3 专用 starter，内含 MyBatis + HikariCP 由 Boot 数据源自动配置接管） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- MySQL 驱动（Boot 8.x 用 com.mysql:mysql-connector-j 新坐标，旧坐标 mysql:mysql-connector-java 已弃用） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Boot 打包插件：mvn package 产出可执行 jar（M6 部署用） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
